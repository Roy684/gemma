          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
      </div>

      <div>
        <label for="aadhaar_number" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Aadhaar Number</label>
        <input type="text" id="aadhaar_number" name="aadhaar_number" required placeholder="12-digit Aadhaar number" pattern="\d{12}"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
      </div>

      <div>
        <label for="mobile_number" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Mobile Number</label>
        <input type="tel" id="mobile_number" name="mobile_number" required placeholder="10-digit mobile number"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
      </div>

      <div>
        <label for="state" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">State</label>
        <select id="state" name="state" required
          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 focus:outline-none focus:border-indigo-500 transition">
          <option value="">Select State</option>
          <option value="West Bengal">West Bengal</option>
          <option value="Maharashtra">Maharashtra</option>
          <option value="Delhi">Delhi</option>
          <option value="Karnataka">Karnataka</option>
          <option value="Tamil Nadu">Tamil Nadu</option>
        </select>
      </div>

      <div>
        <label for="district" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">District</label>
        <input type="text" id="district" name="district" required placeholder="Enter district"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
      </div>

      <div>
        <label for="address" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Full Address</label>
        <textarea id="address" name="address" required rows="2" placeholder="House no., street, locality"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition"></textarea>
      </div>

      <div>
        <label for="category" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Card Category</label>
        <select id="category" name="category" required
          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 focus:outline-none focus:border-indigo-500 transition">
          <option value="">Select Category</option>
          <option value="APL">APL (Above Poverty Line)</option>
          <option value="BPL">BPL (Below Poverty Line)</option>
          <option value="AAY">AAY (Antyodaya Anna Yojana)</option>
        </select>
      </div>

