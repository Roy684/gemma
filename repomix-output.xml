<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Family Level Data Collection Form</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background-color: #fcf8f5; color: #4338ca; font-family: system-ui, -apple-system, sans-serif; }
    .nav-active { border-color: #9a3412; color: #9a3412; font-weight: 700; }
    .tab-header-active { border-color: #9a3412; background-color: #fffaf7; }
    .glass-input {
      background-color: #ffffff;
      border: 1px solid #e5e7eb;
      color: #1f2937;
      transition: all 0.2s;
    }
    .glass-input:focus {
      border-color: #9a3412;
      box-shadow: 0 0 0 2px rgba(154, 52, 18, 0.15);
      outline: none;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <!-- Top Header bar -->
  <header class="bg-white border-b border-orange-100 px-6 py-3.5 flex justify-between items-center">
    <div class="flex items-center gap-2">
      <span class="text-lg font-bold text-amber-900">Family Data Collection</span>
    </div>
    <div class="flex items-center gap-4 text-xs font-semibold text-amber-900">
      <span><i class="fa-regular fa-user mr-1"></i> Citizen Portal</span>
      <span class="cursor-pointer text-orange-700"><i class="fa-solid fa-arrow-right-from-bracket"></i></span>
    </div>
  </header>

  <div class="flex-1 flex">
    <!-- Left Sidebar -->
    <aside class="w-64 bg-white border-r border-orange-50/80 p-5 flex flex-col gap-1.5 flex-shrink-0">
      <div class="flex items-center gap-3 mb-6 p-1.5">
        <div class="w-8 h-8 rounded-lg bg-orange-850 flex items-center justify-center text-white">
          <i class="fa-solid fa-file-invoice"></i>
        </div>
        <div>
          <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Family Form</h2>
          <p class="text-[10px] text-slate-400">VERSION v2.0</p>
        </div>
      </div>

      <nav class="space-y-1">
        <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-orange-900/80 bg-orange-50/50">
          <i class="fa-solid fa-circle-info text-orange-800"></i> Basic Info
        </a>
        <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-500 hover:bg-slate-50">
          <i class="fa-solid fa-bowl-food"></i> Ration Card / Subsidy
        </a>
        <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-500 hover:bg-slate-50">
          <i class="fa-solid fa-house-chimney"></i> Assets
        </a>
        <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-500 hover:bg-slate-50">
          <i class="fa-solid fa-briefcase"></i> Income / Profession
        </a>
        <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-500 hover:bg-slate-50">
          <i class="fa-solid fa-id-card"></i> Identity Docs
        </a>
        <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold text-slate-500 hover:bg-slate-50">
          <i class="fa-solid fa-graduation-cap"></i> Govt Schemes
        </a>
      </nav>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 p-8 max-w-4xl mx-auto flex flex-col gap-6">
      
      <!-- Top Step Headers (tabs style matching West Bengal social registry portal) -->
      <div class="grid grid-cols-3 gap-4">
        <div id="step-tab-1" class="border-2 border-orange-800 bg-[#fffaf7] rounded-2xl p-4 transition-all duration-300">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-orange-800">Step 1</span>
          <span class="text-xs font-bold text-slate-800">Head of Family</span>
        </div>
        <div id="step-tab-2" class="border-2 border-slate-200 bg-white rounded-2xl p-4 transition-all duration-300">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">Step 2</span>
          <span class="text-xs font-bold text-slate-800">Demographics &amp; Address</span>
        </div>
        <div id="step-tab-3" class="border-2 border-slate-200 bg-white rounded-2xl p-4 transition-all duration-300">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">Step 3</span>
          <span class="text-xs font-bold text-slate-800">Declaration &amp; Submit</span>
        </div>
      </div>

      <!-- Main Form Wrapper -->
      <form id="family-form" onsubmit="handleSubmit(event)" class="bg-white border border-orange-100 rounded-3xl p-8 shadow-sm flex flex-col gap-6">
        
        <!-- ==================== STEP 1: BASIC INFO ==================== -->
        <div id="step-content-1" class="space-y-6">
          <div class="border-b border-orange-50 pb-3">
            <h3 class="text-sm font-bold text-slate-800">Basic Information</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="hof_name" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">HOF Name (As per Aadhaar) *</label>
              <input type="text" id="hof_name" name="hof_name" required placeholder="Full Name" class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
            </div>

            <div>
              <label for="dob" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Date of Birth *</label>
              <input type="text" id="dob" name="dob" required placeholder="DD/MM/YYYY" class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
            </div>

            <div>
              <label for="gender" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Gender *</label>
              <select id="gender" name="gender" required class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
                <option value="">Select...</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div>
              <label for="category" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Category *</label>
              <select id="category" name="category" required class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
                <option value="">Select Category...</option>
                <option value="General">General</option>
                <option value="SC">SC</option>
                <option value="ST">ST</option>
                <option value="OBC">OBC</option>
              </select>
            </div>

            <div>
              <label for="religion" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Religion *</label>
              <select id="religion" name="religion" required class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
                <option value="">Select Religion...</option>
                <option value="Hindu">Hindu</option>
                <option value="Islam">Islam</option>
                <option value="Christian">Christian</option>
                <option value="Sikh">Sikh</option>
                <option value="Buddhist">Buddhist</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div>
              <label for="contact_no" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Contact No (Aadhaar linked) *</label>
              <input type="tel" id="contact_no" name="contact_no" required placeholder="10-digit mobile" class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
            </div>

            <div>
              <label for="family_members" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Total No. of Family Members including HOF</label>
              <input type="number" id="family_members" name="family_members" value="1" min="1" class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
            </div>

            <div>
              <label for="disability_status" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Disability Status *</label>
              <select id="disability_status" name="disability_status" required class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
                <option value="No">No</option>
                <option value="Yes">Yes</option>
              </select>
            </div>

            <div class="md:col-span-2">
              <label for="aadhaar_no" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Aadhaar No. *</label>
              <input type="text" id="aadhaar_no" name="aadhaar_no" required placeholder="12-digit Aadhaar" class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
            </div>
          </div>
        </div>

        <!-- ==================== STEP 2: DEMOGRAPHICS & ADDRESS ==================== -->
        <div id="step-content-2" class="space-y-6 hidden">
          <div class="border-b border-orange-50 pb-3">
            <h3 class="text-sm font-bold text-slate-800">Family Demographics &amp; Address</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="md:col-span-2">
              <label for="permanent_address" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Permanent Address *</label>
              <textarea id="permanent_address" name="permanent_address" required rows="2" placeholder="Street, village, ward details" class="w-full px-4 py-2.5 rounded-xl glass-input text-xs"></textarea>
            </div>

            <div>
              <label for="district" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">District *</label>
              <select id="district" name="district" required class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
                <option value="">Select District...</option>
                <option value="KMC">KMC</option>
                <option value="Howrah">Howrah</option>
                <option value="Hooghly">Hooghly</option>
                <option value="North 24 Parganas">North 24 Parganas</option>
                <option value="South 24 Parganas">South 24 Parganas</option>
              </select>
            </div>

            <div>
              <label for="area_type" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Area Type *</label>
              <select id="area_type" name="area_type" required class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
                <option value="">Select Type...</option>
                <option value="Urban">Urban</option>
                <option value="Rural">Rural</option>
              </select>
            </div>

            <div>
              <label for="pincode" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Pincode *</label>
              <select id="pincode" name="pincode" required class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
                <option value="">Select Pincode...</option>
                <option value="700001">700001</option>
                <option value="700002">700002</option>
                <option value="700009">700009</option>
                <option value="700091">700091</option>
              </select>
            </div>

            <div>
              <label for="police_station" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wide mb-1.5">Police Station</label>
              <select id="police_station" name="police_station" class="w-full px-4 py-2.5 rounded-xl glass-input text-xs">
                <option value="">Select Police Station...</option>
                <option value="Bowbazar">Bowbazar</option>
                <option value="Hare Street">Hare Street</option>
                <option value="Muchipara">Muchipara</option>
                <option value="Salt Lake">Salt Lake</option>
              </select>
            </div>
          </div>
        </div>

        <!-- ==================== STEP 3: SUBMIT ==================== -->
        <div id="step-content-3" class="space-y-6 hidden">
          <div class="border-b border-orange-50 pb-3">
            <h3 class="text-sm font-bold text-slate-800">Declaration &amp; Consent</h3>
          </div>

          <div class="bg-amber-50/40 border border-amber-100 rounded-2xl p-5 text-xs text-amber-900 leading-relaxed">
            <h4 class="font-bold mb-2 uppercase tracking-wide"><i class="fa-solid fa-triangle-exclamation mr-1 text-amber-700"></i> Terms of Consent</h4>
            <p class="mb-3">I hereby declare that all the information provided above regarding the family level collection is true to the best of my knowledge.</p>
            <p>I consent to sharing my Aadhaar details for government verification and portal authentication purposes.</p>
          </div>

          <div class="flex items-start gap-3 mt-4">
            <input type="checkbox" id="declaration_accept" name="declaration_accept" required class="w-4 h-4 text-orange-850 accent-orange-850 mt-0.5 rounded cursor-pointer">
            <label for="declaration_accept" class="text-xs font-semibold text-slate-700 cursor-pointer leading-tight select-none">
              I accept the terms of declaration and authorize submission of this registry form. *
            </label>
          </div>
        </div>

        <!-- ==================== ACTIONS / NAVIGATION BUTTONS ==================== -->
        <div class="flex justify-between items-center border-t border-orange-50 pt-5 mt-4">
          <button type="button" id="prev_btn" onclick="moveStep(-1)" class="hidden text-xs font-bold text-slate-500 hover:text-slate-700 transition px-4 py-2">
            <i class="fa-solid fa-chevron-left mr-1"></i> Back
          </button>
          
          <button type="button" id="next_btn" onclick="moveStep(1)" class="ml-auto bg-orange-800 hover:bg-orange-700 font-bold text-xs text-white px-8 py-2.5 rounded-xl shadow-md shadow-orange-900/10 transition active:scale-95">
            Next
          </button>
          
          <button type="submit" id="submit_btn" class="hidden ml-auto bg-green-700 hover:bg-green-600 font-bold text-xs text-white px-8 py-2.5 rounded-xl shadow-md shadow-green-900/10 transition active:scale-95">
            Submit
          </button>
        </div>
      </form>

    </main>
  </div>

  <script>
    let currentStep = 1;
    const totalSteps = 3;

    function moveStep(dir) {
      // Basic step validation
      if (dir === 1) {
        const activeFields = document.querySelectorAll(`#step-content-${currentStep} [required]`);
        for (const el of activeFields) {
          if (!el.value || (el.type === 'checkbox' && !el.checked)) {
            el.reportValidity();
            return;
          }
        }
      }

      currentStep += dir;
      updateUI();
    }

    function updateUI() {
      // Toggle visibility of step content
      for (let s = 1; s <= totalSteps; s++) {
        const content = document.getElementById(`step-content-${s}`);
        const tab = document.getElementById(`step-tab-${s}`);
        
        if (s === currentStep) {
          content.classList.remove('hidden');
          tab.className = "border-2 border-orange-800 bg-[#fffaf7] rounded-2xl p-4 transition-all duration-300";
          tab.querySelector('span:first-child').className = "block text-[10px] font-bold uppercase tracking-wider text-orange-800";
        } else {
          content.classList.add('hidden');
          tab.className = "border-2 border-slate-200 bg-white rounded-2xl p-4 transition-all duration-300";
          tab.querySelector('span:first-child').className = "block text-[10px] font-bold uppercase tracking-wider text-slate-400";
        }
      }

      // Actions button state
      const prevBtn = document.getElementById('prev_btn');
      const nextBtn = document.getElementById('next_btn');
      const submitBtn = document.getElementById('submit_btn');

      if (currentStep === 1) {
        prevBtn.classList.add('hidden');
      } else {
        prevBtn.classList.remove('hidden');
      }

      if (currentStep === totalSteps) {
        nextBtn.classList.add('hidden');
        submitBtn.classList.remove('hidden');
      } else {
        nextBtn.classList.remove('hidden');
        submitBtn.classList.add('hidden');
      }
    }

    function handleSubmit(e) {
      e.preventDefault();
      const form = document.getElementById('family-form');
      if (form.reportValidity()) {
        window.location.reload();
      }
    }
  </script>
</body>
</html>
